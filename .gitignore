results/*
# The paper's raw result records are the evidence behind every reported number, and are
# small enough to version alongside the manuscript that cites them.
!results/paper/
*.faiss
.DS_Store

# Build artefact: the submission folder is versioned, the zip of it is not.
RAGSec Paper.zip
RAG Security Paper.zip

# LaTeX build products. MainPaper.pdf is deliberately tracked as the compiled record of
# what was submitted, so it is excepted here rather than force-added each time.
paper-submission/*.pdf
!paper-submission/MainPaper.pdf
!paper-submission/figures/*.pdf

# LaTeX build products
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Overleaf upload bundle, rebuilt on demand.
RAGSec-*.zip

# Cached API completions: large, and specific to one machine's runs.
results/paper/llm-cache.sqlite
